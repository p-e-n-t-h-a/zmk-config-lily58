#include <locale/keys_us_international.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // |  CTRL |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                         &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp EQUAL
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                          &kp Y   &kp U     &kp I      &kp O    &kp P     &kp MINUS
&kp LSHFT  &kp A   &kp S   &kp D     &kp F     &kp G                          &kp H   &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT  &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LALT  &kp LGUI  &mo 0   &kp SPACE    &kp RET   &mo 2   &kp BSPC  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbol {
            bindings = <
&trans        &none  &none  &none      &none      &none                          &none      &none          &none           &none                 &none                  &none
&trans        &none  &none  &kp KP_N7  &kp KP_N8  &kp KP_N9                      &kp GRAVE  &kp EXCL       &kp AT          &kp HASH              &kp DOLLAR             &kp PERCENT
&kp C_VOL_UP  &none  &none  &kp KP_N4  &kp KP_N5  &kp KP_N6                      &kp CARET  &kp AMPERSAND  &kp ASTRK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp TILDE
&kp C_VOL_DN  &none  &none  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N0    &mo 5  &kp MINUS  &kp PLUS       &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp PIPE               &trans
                            &trans     &trans     &none      &none        &none  &trans     &kp DEL        &trans
            >;
        };

        navigation {
            display-name = "Raise Layer";

            // ------------------------------------------------------------------------------------------------------------
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |        |       |       |       |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |                   |      |   UE   |   ^   |  OE   |       |       |
            // |       |  AE |  SZ |      |      |      |                   |      |   <-   |   v   |  ->   |       |       |
            // |       |     |     |      |      |      |        |  |       |  +   |   -    |   =   |  [    |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |   DEL  |       |

            bindings = <
&trans  &none            &none             &none         &none             &none                   &none  &none            &none             &none            &none      &none
&trans  &none            &none             &none         &mo 4             &none                   &none  &kp EN_U_UMLAUT  &kp UP            &kp EN_O_UMLAUT  &none      &none
&trans  &kp EN_A_UMLAUT  &kp EN_SZ         &none         &mo 3             &none                   &none  &kp LEFT         &kp DOWN          &kp RIGHT        &none      &none
&trans  &none            &kp LS(LC(LALT))  &kp LC(LALT)  &kp LS(LEFT_GUI)  &none   &none    &none  &none  &kp C_PREVIOUS   &kp C_PLAY_PAUSE  &kp C_NEXT       &kp TILDE  &trans
                                           &trans        &trans            &trans  &none    &none  &none  &kp DEL          &trans
            >;
        };

        mouse {
            bindings = <
&trans  &none  &none  &none   &none   &none                   &none           &none           &none           &none            &none            &none
&trans  &none  &none  &none   &none   &none                   &none           &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &none            &none
&trans  &none  &none  &none   &none   &none                   &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT  &none
&trans  &none  &none  &none   &none   &none   &none    &none  &none           &mkp LCLK       &mkp MCLK       &mkp RCLK        &none            &none
                      &trans  &trans  &trans  &none    &none  &trans          &trans          &trans
            >;
        };

        system {
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none  &none  &none  &none  &none  &none
&bootloader  &sys_reset    &none         &none         &none         &none                         &none  &none  &none  &none  &none  &none
&none        &none         &none         &none         &none         &none                         &none  &none  &none  &none  &none  &none
&none        &none         &none         &none         &none         &none         &none    &none  &none  &none  &none  &none  &none  &none
                                         &none         &none         &none         &none    &none  &none  &none  &none
            >;
        };

        f_layer {
            bindings = <
&kp F1  &kp F2  &kp F3      &kp F4   &kp F5       &kp F6                   &none  &none  &none  &none  &none  &none
&kp F7  &kp F8  &kp F9      &kp F10  &kp F11      &kp F12                  &none  &none  &none  &none  &none  &none
&none   &none   &kp LA(F4)  &kp F2   &kp LS(F10)  &none                    &none  &none  &none  &none  &none  &none
&none   &none   &none       &none    &none        &none    &none    &none  &none  &none  &none  &none  &none  &none
                            &none    &none        &none    &none    &none  &none  &none  &none
            >;
        };
    };
};
