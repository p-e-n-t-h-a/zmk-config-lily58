#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <locale/keys_us_international.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// |  CTRL |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                     &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp GRAVE
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                      &kp Y  &kp U    &kp I     &kp O   &kp P    &kp MINUS
&kp LSHFT &kp A  &kp S  &kp D    &kp F    &kp G                      &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LCTRL &kp Z  &kp X  &kp C    &kp V    &kp B  &kp LBKT   &kp RBKT &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LALT &kp LGUI &mo 1  &kp SPACE  &kp RET  &mo 2  &kp BSPC &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "Lower Layer";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   | OFF  |       |       |      |       |       |
// | POWRS |     |     |  7   |  8   |  9   |                   |  `   |  !    |  @    |  #   |   $   |  %    |
// | vol + |     | >\= |  4   |  5   |  6   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
// | vol - | <<  | >>  |  1   |  2   |  3   |   0    |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
//                     |      |      |      |        |  |       |      |  DEL  |       |
            bindings = <
&bt BT_CLR        &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3 &bt BT_SEL 4                  &kp soft_off    &trans    &trans    &trans    &trans     &trans
&ext_power EP_TOG &trans           &trans            &kp KP_N7         &kp KP_N8    &kp KP_N9                     &kp GRAVE       &kp EXCL  &kp AT    &kp HASH  &kp DOLLAR &kp PRCNT 
&kp C_VOLUME_UP   &trans           &kp C_PP          &kp KP_N4         &kp KP_N5    &kp KP_N6                     &kp CARET       &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR   &kp TILDE
&kp C_VOLUME_DOWN &kp C_PREV       &kp C_NEXT        &kp KP_N1         &kp KP_N2    &kp KP_N3 &kp KP_N0 &trans    &kp MINUS       &kp PLUS  &kp LBRC  &kp RBRC   &kp PIPE
                                                     &trans            &trans       &trans    &trans    &trans    &trans          &kp DEL   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "Raise Layer";
// ------------------------------------------------------------------------------------------------------------
// |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |        |       |       |       |       |
// |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |                   |      |   UE   |   ^   |  OE   |       |       |
// |       |  AE |  SZ |      |      |      |                   |      |   <-   |   v   |  ->   |       |       |
// |       |     |     |      |      |      |        |  |       |  +   |   -    |   =   |  [    |   ]   |   \   |
//                     |      |      |      |        |  |       |      |   DEL  |       |
            bindings = <
&kp F1    &kp F2          &kp F3        &kp F4  &kp F5  &kp F6                       &trans      &trans          &trans    &trans          &trans    &trans
&kp F7    &kp F8          &kp F9        &kp F10 &kp F11 &kp F12                      &trans      &kp EN_U_UMLAUT &kp UP    &kp EN_O_UMLAUT &trans    &trans
&trans    &kp EN_A_UMLAUT &kp EN_SZ     &trans  &trans  &trans                       &trans      &kp LEFT        &kp DOWN  &kp RIGHT       &trans    &trans
&trans    &trans          &trans        &trans  &trans  &trans    &trans    &trans   &kp KP_PLUS &kp MINUS       &kp EQUAL &kp LBKT        &kp RBKT  &kp BSLH
                          &trans        &trans  &trans  &trans    &trans    &trans   &kp DEL     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
