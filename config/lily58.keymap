#include <locale/keys_us_international.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Chillin Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                         &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp EQUAL
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                          &kp Y   &kp U     &kp I      &kp O    &kp P     &kp MINUS
&kp LSHFT  &kp A   &kp S   &kp D     &kp F     &kp G                          &kp H   &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT  &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &kp RET   &mo 2   &kp BSPC  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbol {
            bindings = <
&trans        &kp LG(P)        &kp KP_DIVIDE    &kp KP_EQUAL  &kp KP_PLUS  &kp KP_MINUS                      &none      &none          &none           &none                 &none                  &to 0
&trans        &kp PRINTSCREEN  &kp KP_ASTERISK  &kp KP_N7     &kp KP_N8    &kp KP_N9                         &kp GRAVE  &kp EXCL       &kp AT          &kp HASH              &kp DOLLAR             &kp PERCENT
&kp C_VOL_UP  &kp LC(H)        &kp KP_COMMA     &kp KP_N4     &kp KP_N5    &kp KP_N6                         &kp CARET  &kp AMPERSAND  &kp ASTRK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH
&kp C_VOL_DN  &tog 1           &kp DOT          &kp KP_N1     &kp KP_N2    &kp KP_N3     &kp KP_N0    &mo 5  &kp MINUS  &kp PLUS       &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp PIPE               &trans
                                                &trans        &trans       &none         &none        &none  &trans     &kp DEL        &mo 6
            >;

            label = "Symbols";
        };

        navigation {
            bindings = <
&trans  &none  &none             &none         &none             &none                   &none     &none           &none             &none          &none      &to 0
&trans  &none  &none             &none         &mo 4             &none                   &none     &kp PAGE_UP     &kp UP            &kp PAGE_DOWN  &none      &none
&trans  &none  &to 1             &none         &mo 3             &none                   &kp HOME  &kp LEFT        &kp DOWN          &kp RIGHT      &kp END    &none
&trans  &none  &kp LS(LC(LALT))  &kp LC(LALT)  &kp LS(LEFT_GUI)  &none   &none    &none  &none     &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT     &kp TILDE  &trans
                                 &trans        &trans            &trans  &none    &none  &none     &kp DEL         &trans
            >;

            label = "Navigate";
        };

        mouse {
            bindings = <
&trans  &none  &none  &none   &none   &none                   &none           &none           &none           &none            &none            &to 0
&trans  &none  &none  &none   &none   &none                   &none           &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &none            &none
&trans  &none  &none  &none   &none   &none                   &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT  &none
&trans  &none  &none  &none   &none   &none   &none    &none  &none           &mkp LCLK       &mkp MCLK       &mkp RCLK        &none            &none
                      &trans  &trans  &trans  &none    &none  &trans          &trans          &trans
            >;

            label = "Mouse";
        };

        system {
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none  &none  &none  &none  &none  &to 0
&bootloader  &sys_reset    &none         &none         &none         &none                         &none  &none  &none  &none  &none  &none
&none        &none         &none         &none         &none         &none                         &none  &none  &none  &none  &none  &none
&none        &none         &none         &none         &none         &none         &none    &none  &none  &none  &none  &none  &none  &none
                                         &none         &none         &none         &none    &none  &none  &none  &none
            >;

            label = "System";
        };

        f_layer {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4      &kp F5       &kp F6                        &kp KP_NUMLOCK  &none   &none   &none  &none  &to 0
&kp F7  &kp F8  &kp F9  &kp F10     &kp F11      &kp F12                       &kp LA(F4)      &none   &none   &none  &none  &none
&trans  &none   &none   &kp F2      &kp LS(F10)  &none                         &none           &none   &none   &none  &none  &none
&trans  &none   &none   &kp LA(F2)  &none        &none    &none    &none       &none           &none   &none   &none  &none  &none
                        &trans      &trans       &trans   &none    &kp LC(F5)  &trans          &trans  &trans
            >;

            label = "F Layer";
        };

        Windows {
            label = "Windows";
            bindings = <
&trans  &trans  &trans  &trans         &trans         &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LG(KP_N7)  &kp LG(KP_N8)  &kp LG(KP_N9)                           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LG(KP_N4)  &kp LG(KP_N5)  &kp LG(KP_N6)                           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LG(KP_N1)  &kp LG(KP_N2)  &kp LG(KP_N3)  &kp LG(KP_N0)    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans         &trans         &trans         &trans           &trans  &trans  &trans  &trans
            >;
        };
    };
};
